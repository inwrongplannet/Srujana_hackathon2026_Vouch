{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "gh pr view*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr list*": "allow"
    }
  }
}
