# VeriTrust Environment Configuration
# Copy this file to .env and adjust values as needed.
# The real .env is ignored by git and must never be committed.

# Scoring & Underwriting Parameters
K=1.0                           # Epistemic uncertainty penalty parameter k (kappa) for Lower Confidence Bound
ALPHA=0.6                       # Weight of graph trust vs cash-flow in composite capacity mu
BETA=0.1                        # Reputation boost exponent for settled loans and active vouches
HOP_DECAY=0.5                   # Geometric hop decay factor (lambda / X)
BASE_UNIT_INR=10000.00          # Base monetary conversion scale per score point in INR

# Lending & Slashing Parameters
DEFAULT_BASE_SLASH=10.0         # Primary default slash amount (delta0)
GAMMA=0.5                       # Direct sponsor penalty scaling factor
BORROWER_REWARD=2.0             # Credibility increment minted to borrower on repayment
SPONSOR_REWARD=1.0              # Reputation increment awarded to sponsors on repayment
CIRCUIT_BREAKER_THRESHOLD=0.30  # Cluster default rate threshold (theta)

# Identity & Security Stub (# ZK_STUB)
POSEIDON_PROTOCOL_SALT=veritrust_demo_protocol_salt_2026
DEMO_MODE=true
